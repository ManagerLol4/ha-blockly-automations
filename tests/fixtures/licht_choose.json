{
  "id": "1700000000003",
  "alias": "Lichtsteuerung: Flur",
  "description": "Schalter toggelt Dauerlicht, Bewegung schaltet für 1 Minute.",
  "triggers": [
    { "device_id": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "domain": "hue", "type": "initial_press", "subtype": 1, "id": "schalter", "trigger": "device" },
    { "entity_id": "input_button.flur", "id": "schalter", "trigger": "state", "to": null, "not_from": ["unavailable", "unknown"] },
    { "entity_id": "binary_sensor.flur_bewegung", "to": "on", "id": "an", "trigger": "state" },
    { "entity_id": "binary_sensor.flur_bewegung", "to": "off", "for": { "minutes": 1 }, "id": "aus", "trigger": "state" }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [{ "condition": "trigger", "id": "schalter" }],
          "sequence": [
            { "action": "input_boolean.toggle", "target": { "entity_id": "input_boolean.flur_modus" } },
            {
              "if": [{ "condition": "state", "entity_id": "input_boolean.flur_modus", "state": "on" }],
              "then": [{ "action": "light.turn_on", "target": { "entity_id": "light.flur" }, "data": { "brightness_pct": "{{ 50 }}" } }],
              "else": [{ "action": "light.turn_off", "target": { "entity_id": "light.flur" } }]
            }
          ]
        },
        {
          "conditions": [{ "condition": "trigger", "id": "an" }, "{{ is_state('input_boolean.flur_modus', 'off') }}"],
          "sequence": [{ "action": "light.turn_on", "target": { "entity_id": "light.flur" } }]
        }
      ],
      "default": [{ "delay": { "seconds": 5 } }, { "repeat": { "count": 2, "sequence": [{ "event": "x" }] } }]
    }
  ],
  "mode": "restart"
}
